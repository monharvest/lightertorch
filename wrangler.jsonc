// Cloudflare Worker with static assets (replaced Cloudflare Pages, 2026-11).
// `npm run build` writes dist/; `npx wrangler deploy` uploads it. There is no
// Worker script: every request is a file, a _redirects rule or the 404 page.
// public/_redirects and public/_headers apply as they did on Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lightertorch",
  "account_id": "01644e982bf4fd61e45c31c2dc1a2a57",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // lightertorch.com is served through this route (www -> apex and http ->
  // https are zone rules). workers.dev is off: a second public copy of the site.
  "routes": [{ "pattern": "lightertorch.com/*", "zone_name": "lightertorch.com" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
