---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getArticles, newestFirst, postHref, resolveTopics, topicOf } from '../lib/posts';

const posts = (await getArticles()).sort(newestFirst);
const topics = resolveTopics(posts);
const latest = posts.slice(0, 6);
// Every guide grouped by topic, A to Z, so each one stays a click from home.
const groups = topics.map((topic) => ({
	topic,
	posts: posts.filter((p) => topicOf(p) === topic.id).sort((a, b) => a.data.title.localeCompare(b.data.title)),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1040px;
			}
			section {
				margin: 0 0 3.5rem;
			}
			section > h2 {
				margin: 0 0 1rem;
				font-size: 1.75rem;
			}
			.intro {
				max-width: 42rem;
				margin-bottom: 2rem;
			}
			.intro h1 {
				margin: 0 0 0.6rem;
				line-height: 1.2;
			}
			.intro p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}

			/* Topic tiles */
			.topics {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 1.25rem;
			}
			.topic {
				display: flex;
				flex-direction: column;
				padding: 1.25rem 1.25rem 1.1rem;
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-top: 4px solid var(--coral);
				border-radius: 12px;
			}
			.topic-ic {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2.6rem;
				height: 2.6rem;
				margin-bottom: 0.75rem;
				color: var(--coral-text);
				background: var(--coral-soft);
				border-radius: 50%;
			}
			.topic h2 {
				margin: 0 0 0.35rem;
				font-size: 1.35rem;
			}
			.topic p {
				margin: 0 0 0.75rem;
				font-size: 0.9rem;
				line-height: 1.5;
				color: rgb(var(--gray));
			}
			.topic ul {
				margin: 0 0 1rem;
				padding: 0;
				list-style: none;
				font-size: 0.95rem;
				line-height: 1.35;
			}
			.topic li {
				margin: 0;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.topic li a {
				display: block;
				padding: 0.5rem 0;
				font-weight: 700;
				color: rgb(var(--black));
				text-decoration: none;
			}
			.topic li a:hover,
			.all li a:hover {
				color: var(--coral-text);
			}
			.topic-all {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				margin-top: auto;
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--coral-text);
				text-decoration: none;
			}
			.topic-all:hover {
				text-decoration: underline;
			}

			/* Every guide */
			.all-cols {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 1.5rem 2rem;
			}
			.all-cols > div {
				scroll-margin-top: 1rem;
			}
			.all h3 {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin: 0 0 0.5rem;
				padding-bottom: 0.4rem;
				font-size: 1.1rem;
				border-bottom: 2px solid var(--coral);
			}
			.all h3 span {
				font-size: 0.9rem;
				font-weight: 400;
				color: rgb(var(--gray));
			}
			.all ul {
				margin: 0;
				padding: 0;
				list-style: none;
				font-size: 0.9rem;
				line-height: 1.4;
			}
			.all li {
				margin: 0;
				padding: 0.45rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.all li a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Flashlight and lighter guides that stay useful</h1>
				<p>
					Reviews and how-tos for buying a flashlight that lasts, fixing a Zippo, and
					answering the lighter questions people actually search.
				</p>
			</section>

			<section class="topics" aria-label="Browse by topic">
				{groups.map(({ topic, posts }) => (
					<div class="topic">
						<span class="topic-ic"><Icon name={topic.icon} size={22} /></span>
						<h2>{topic.label}</h2>
						<p>{topic.blurb}</p>
						<ul>
							{[topic.feat, ...topic.cols.map((c) => c.links[0])].map((l) => (
								<li><a href={l.href}>{l.label}</a></li>
							))}
						</ul>
						<a class="topic-all" href={`#guides-${topic.id}`}>
							All {posts.length} {topic.noun} guides <Icon name="arrow-right" size={16} />
						</a>
					</div>
				))}
			</section>

			<section aria-labelledby="latest">
				<h2 id="latest">Latest guides</h2>
				<ul class="card-grid">
					{latest.map((p) => <li><PostCard post={p} /></li>)}
				</ul>
			</section>

			<section class="all" aria-labelledby="all-guides">
				<h2 id="all-guides">Every guide</h2>
				<div class="all-cols">
					{groups.map(({ topic, posts }) => (
						<div id={`guides-${topic.id}`}>
							<h3>{topic.label} <span>{posts.length}</span></h3>
							<ul>
								{posts.map((p) => <li><a href={postHref(p)}>{p.data.title}</a></li>)}
							</ul>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
