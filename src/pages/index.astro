---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => (post.data.categories?.length ?? 0) > 0)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.intro {
			max-width: 42rem;
			margin: 0 0 2rem;
		}
		.intro h1 {
			margin: 0 0 0.6rem;
			line-height: 1.2;
		}
		.intro p,
		.intro ul {
			color: rgb(var(--gray-dark));
		}
		.intro ul {
			display: block;
			margin: 0.75rem 0 0;
			padding-left: 1.2rem;
			list-style: disc;
		}
		.intro li {
			width: auto;
			margin: 0.35rem 0;
		}
		@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Flashlight and lighter guides that stay useful</h1>
				<p>
					Reviews and how-tos for buying a flashlight that lasts, fixing a Zippo, and
					answering the lighter questions people actually search.
				</p>
				<ul>
					<li><a href="/the-most-durable-flashlights-for-outdoor-use-a-comprehensive-guide/">Most durable flashlights</a></li>
					<li><a href="/what-is-the-best-long-range-flashlight/">Powerful rechargeable and long-range torches</a></li>
					<li><a href="/zippo-repairs-how-to-take-care-of-your-zippo-lighter-and-find-replacement-parts/">Zippo repair and lifetime service</a></li>
					<li><a href="/a-gas-lighter-last-how-long/">How long a BIC lighter lasts</a></li>
				</ul>
			</section>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/${post.id}/`}>
									{post.data.heroImage && (
										<img width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
